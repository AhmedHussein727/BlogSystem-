@model Blog.MVC.ViewModels.EditPostViewModel
@using Blog.Domain.Entities.Enums

@{
    ViewData["Title"] = "Edit Post";
}

<div style="max-width:720px; margin:0 auto;">
    <a asp-action="Index" style="color:var(--muted); text-decoration:none; font-size:0.875rem; display:inline-flex; align-items:center; gap:0.4rem; margin-bottom:2rem;">
        <i class="fas fa-arrow-left"></i> Back to Posts
    </a>

    <h1 class="page-title">Edit Post</h1>
    <p class="page-subtitle">Update your article content and settings</p>

    <div class="card-dark" style="margin-top:1.5rem;">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label class="form-label">Title</label>
                <input asp-for="Post.Title" class="form-input" placeholder="Enter post title..." />
                <span asp-validation-for="Post.Title" class="field-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Content</label>
                <textarea asp-for="Post.Content" class="form-textarea" rows="10" placeholder="Write your content here..."></textarea>
                <span asp-validation-for="Post.Content" class="field-error"></span>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
                <div class="form-group">
                    <label class="form-label">Category</label>
                    <select asp-for="Post.CategoryId" asp-items="Model.Categories" class="form-select-dark"></select>
                </div>
                <div class="form-group">
                    <label class="form-label">Status</label>
                    <select asp-for="Post.Status" asp-items="Html.GetEnumSelectList<Status>()" class="form-select-dark"></select>
                </div>
            </div>

            <hr class="divider" />

            <div style="display:flex; gap:1rem;">
                <button type="submit" class="btn-gold">
                    <i class="fas fa-save"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
