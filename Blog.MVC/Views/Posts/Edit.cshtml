@model Blog.MVC.ViewModels.EditPostViewModel
@using Blog.Domain.Entities.Enums

<h2>Edit Post</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="Post.Title"></label>
        <input asp-for="Post.Title" />
    </div>

    <br />

    <div>
        <label asp-for="Post.Content"></label>

        <textarea asp-for="Post.Content"
                  rows="6">
        </textarea>
    </div>

    <br />

    <div>
        <label>Category</label>

        <select asp-for="Post.CategoryId"
                asp-items="Model.Categories">
        </select>
    </div>

    <br />

    <div>
        <label>Status</label>

        <select asp-for="Post.Status"
                asp-items="Html.GetEnumSelectList<Status>()">
        </select>
    </div>

    <br />

    <button type="submit">
        Save Changes
    </button>

</form>