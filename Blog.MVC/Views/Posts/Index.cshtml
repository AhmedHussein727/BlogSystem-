@using Blog.MVC.DTOs
@using Blog.MVC.ViewModels
@inject Blog.MVC.ServicesAbstraction.ITokenParserService TokenParser

@model PostsIndexViewModel

<h1>Posts</h1>

@if (TokenParser.GetRole() == "Admin"
|| TokenParser.GetRole() == "Editor")
{
    <a asp-action="Create">
        Create New Post
    </a>

    <hr />
}

@foreach (var post in Model.Posts)
{
    <div style="margin-bottom:20px">

        <h2>@post.Title</h2>

        <p>@post.Content</p>

        <a asp-action="Details"
           asp-route-id="@post.Id">
            Details
        </a>

        @if (TokenParser.GetRole() == "Admin"
            || TokenParser.GetRole() == "Editor")
        {
            <text> | </text>

            <a asp-action="Edit"
               asp-route-id="@post.Id">
                Edit
            </a>
        }

        @if (TokenParser.GetRole() == "Admin")
        {
            <text> | </text>

            <form asp-action="Delete"
                  asp-route-id="@post.Id"
                  method="post"
                  style="display:inline">

                <button type="submit"
                        onclick="return confirm('Are you sure?')">
                    Delete
                </button>

            </form>
        }

    </div>

    <hr />
}

<div>

    @if (Model.PageIndex > 1)
    {
        <a asp-action="Index"
           asp-route-pageIndex="@(Model.PageIndex - 1)">
            Previous
        </a>
    }

    <span>
        Page @Model.PageIndex
    </span>

    @if (Model.PageIndex * Model.PageSize < Model.Count)
    {
        <a asp-action="Index"
           asp-route-pageIndex="@(Model.PageIndex + 1)">
            Next
        </a>
    }

</div>