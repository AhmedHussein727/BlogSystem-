@using Blog.Domain.Entities.Enums
@using Blog.MVC.DTOs
@using Blog.MVC.ViewModels
@inject Blog.MVC.ServicesAbstraction.ITokenParserService TokenParser

@model PostsIndexViewModel

@{
    ViewData["Title"] = "Posts";
    var role = TokenParser.GetRole();
}

<div style="display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:1rem; margin-bottom:2rem;">
    <div>
        <h1 class="page-title">Latest Posts</h1>
        <p class="page-subtitle">Explore articles, stories and ideas</p>
    </div>
    @if (role == "Admin" || role == "Editor")
    {
        <a asp-action="Create" class="btn-gold">
            <i class="fas fa-plus"></i> New Post
        </a>
    }
</div>

<form method="get" asp-action="Index" style="display:flex; gap:1rem; flex-wrap:wrap; margin-bottom:2rem;">
    <select name="categoryName" asp-items="Model.Categories" class="form-select-dark" style="max-width:220px;">
        <option value="">All Categories</option>
    </select>
    <select name="status" class="form-select-dark" style="max-width:180px;">
        <option value="">All Statuses</option>
        <option value="Draft" selected="@(Model.Status == "Draft")">Draft</option>
        <option value="Published" selected="@(Model.Status == "Published")">Published</option>
        <option value="Archived" selected="@(Model.Status == "Archived")">Archived</option>
    </select>
    <button type="submit" class="btn-gold"><i class="fas fa-filter"></i> Filter</button>
</form>

<hr class="divider" />

@if (!Model.Posts.Any())
{
    <div style="text-align:center; padding:4rem 0; color:var(--muted);">
        <i class="fas fa-newspaper" style="font-size:3rem; margin-bottom:1rem; display:block; opacity:0.3;"></i>
        <p>No posts found. Try adjusting your filters.</p>
    </div>
}
else
{
    <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap:1.5rem;">
        @foreach (var post in Model.Posts)
        {
            <div class="card-dark" style="display:flex; flex-direction:column; justify-content:space-between;">
                <div>
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
                        <span class="badge-status @(post.Status == Status.Published ? "badge-published" : post.Status == Status.Draft ? "badge-draft" : "badge-archived")">
                            @post.Status
                        </span>
                        <span style="font-size:0.75rem; color:var(--muted);">
                            <i class="fas fa-tag"></i> @post.CategoryName
                        </span>
                    </div>
                    <div style="font-size:0.78rem; color:var(--muted); margin-bottom:0.5rem;">
                        <i class="fas fa-user"></i> @post.AuthorName
                    </div>
                    <h3 style="font-family:'Playfair Display',serif; font-size:1.2rem; font-weight:700; margin-bottom:0.6rem; line-height:1.4;">
                        @post.Title
                    </h3>
                    <p style="color:var(--muted); font-size:0.875rem; line-height:1.6; margin-bottom:1.25rem;">
                        @(post.Content?.Length > 120 ? post.Content.Substring(0, 120) + "..." : post.Content)
                    </p>
                </div>
                <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                    <a asp-action="Details" asp-route-id="@post.Id" class="btn-outline" style="font-size:0.8rem; padding:0.4rem 0.9rem;">
                        <i class="fas fa-eye"></i> Read
                    </a>
                    @if (role == "Admin" || role == "Editor")
                    {
                        <a asp-action="Edit" asp-route-id="@post.Id" class="btn-warning-soft">
                            <i class="fas fa-pen"></i> Edit
                        </a>
                    }
                    @if (role == "Admin")
                    {
                        <form asp-action="Delete" asp-route-id="@post.Id" method="post" style="display:inline;"
                              onsubmit="return confirm('Delete this post permanently?')">
                            <button type="submit" class="btn-danger-soft">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}

<div class="pagination-custom">
    @if (Model.PageIndex > 1)
    {
        <a class="page-btn"
           asp-action="Index"
           asp-route-pageIndex="@(Model.PageIndex - 1)"
           asp-route-categoryName="@Model.CategoryName"
           asp-route-status="@Model.Status">
            <i class="fas fa-chevron-left"></i> Prev
        </a>
    }
    <span class="page-btn active">@Model.PageIndex</span>
    @if (Model.PageIndex * Model.PageSize < Model.Count)
    {
        <a class="page-btn"
           asp-action="Index"
           asp-route-pageIndex="@(Model.PageIndex + 1)"
           asp-route-categoryName="@Model.CategoryName"
           asp-route-status="@Model.Status">
            Next <i class="fas fa-chevron-right"></i>
        </a>
    }
</div>
