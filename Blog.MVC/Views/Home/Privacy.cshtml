@{
    ViewData["Title"] = "Privacy Policy";
}

<div style="max-width:720px; margin:0 auto;">
    <h1 class="page-title">Privacy Policy</h1>
    <p class="page-subtitle">Last updated: January 2026</p>

    <hr class="divider" />

    <div class="card-dark" style="margin-bottom:1.25rem;">
        <h3 style="font-family:'Playfair Display',serif; font-size:1.1rem; font-weight:700; color:var(--gold); margin-bottom:0.75rem;">
            <i class="fas fa-database"></i> Data We Collect
        </h3>
        <p style="color:var(--muted); font-size:0.9rem; line-height:1.7;">
            We collect your email address, display name, and phone number when you register. We also store the posts and comments you create on the platform.
        </p>
    </div>

    <div class="card-dark" style="margin-bottom:1.25rem;">
        <h3 style="font-family:'Playfair Display',serif; font-size:1.1rem; font-weight:700; color:var(--gold); margin-bottom:0.75rem;">
            <i class="fas fa-lock"></i> How We Use It
        </h3>
        <p style="color:var(--muted); font-size:0.9rem; line-height:1.7;">
            Your data is used solely to provide the BlogSystem service. We do not sell or share your personal information with third parties.
        </p>
    </div>

    <div class="card-dark">
        <h3 style="font-family:'Playfair Display',serif; font-size:1.1rem; font-weight:700; color:var(--gold); margin-bottom:0.75rem;">
            <i class="fas fa-cookie"></i> Cookies
        </h3>
        <p style="color:var(--muted); font-size:0.9rem; line-height:1.7;">
            We use an HttpOnly cookie to store your authentication token securely. This cookie expires after 7 days and is never accessible via JavaScript.
        </p>
    </div>
</div>
