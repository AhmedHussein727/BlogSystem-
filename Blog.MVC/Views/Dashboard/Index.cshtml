@model Blog.MVC.DTOs.Dashboard.DashboardDTO

<h1>Admin Dashboard</h1>

<div class="row">

    <div class="col-md-3">

        <div class="card text-center shadow-sm">

            <div class="card-body">

                <h3>@Model.TotalPosts</h3>

                <p>Total Posts</p>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-center shadow-sm">

            <div class="card-body">

                <h3>@Model.TotalComments</h3>

                <p>Total Comments</p>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-center shadow-sm">

            <div class="card-body">

                <h3>@Model.TotalCategories</h3>

                <p>Total Categories</p>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-center shadow-sm">

            <div class="card-body">

                <h3>@Model.TotalUsers</h3>

                <p>Total Users</p>

            </div>

        </div>

    </div>

</div>