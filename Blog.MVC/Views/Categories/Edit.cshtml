@model Blog.MVC.DTOs.Category.UpdateCategoryDto

<h2>Edit Category</h2>

<form asp-action="Edit"
      method="post">

    <div class="mb-3">

        <label>Name</label>

        <input asp-for="Name"
               class="form-control" />

    </div>

    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>