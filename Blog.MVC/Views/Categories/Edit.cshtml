@model Blog.MVC.DTOs.Category.UpdateCategoryDto

@{
    ViewData["Title"] = "Edit Category";
}

<div style="max-width:480px; margin:0 auto;">
    <a asp-action="Index" style="color:var(--muted); text-decoration:none; font-size:0.875rem; display:inline-flex; align-items:center; gap:0.4rem; margin-bottom:2rem;">
        <i class="fas fa-arrow-left"></i> Back to Categories
    </a>

    <h1 class="page-title">Edit Category</h1>
    <p class="page-subtitle">Update the category name</p>

    <div class="card-dark" style="margin-top:1.5rem;">
        <form asp-action="Edit" method="post">
            <div class="form-group">
                <label class="form-label">Category Name</label>
                <input asp-for="Name" class="form-input" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>
            <div style="display:flex; gap:1rem;">
                <button type="submit" class="btn-gold">
                    <i class="fas fa-save"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>
